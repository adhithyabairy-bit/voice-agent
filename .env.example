# ============================================================
# VoiceAI — Environment Variables
# Copy this file to .env.local and fill in your API keys
# ============================================================

# --- Groq API (LLM) ---
# Key: https://console.groq.com/keys
GROQ_API_KEY=
VOICE_LLM_MODEL=llama-3.3-70b-versatile
VOICE_LLM_FALLBACK_MODEL=openai/gpt-oss-20b
MAX_RESPONSE_SENTENCES=2
CONVERSATION_WINDOW_SIZE=10

# --- Sarvam AI (Speech-to-Text & Text-to-Speech) ---
# Key: https://dashboard.sarvam.ai
SARVAM_API_KEY=
SARVAM_STT_LANGUAGE=te-IN
SARVAM_TTS_LANGUAGE=te-IN
SARVAM_TTS_SPEAKER=aditya
SARVAM_TTS_PACE=1.15
VOICE_STT_PROVIDER=sarvam
VOICE_TTS_PROVIDER=sarvam

# --- Voice Activity Detection (VAD) Tuning ---
VAD_SILENCE_THRESHOLD=0.007
VAD_END_SILENCE_MS=120
VAD_MIN_SPEECH_MS=80
VAD_MAX_TURN_DURATION_MS=15000
VAD_PRE_SPEECH_BUFFER_MS=150
VOICE_ECHO_GUARD_MS=120

# --- In-Memory Business Caching ---
BUSINESS_CACHE_TTL_MS=300000

# --- Supabase (Database) ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Telemetry & Development Benchmarking ---
VOICE_DEBUG_LATENCY=false

# --- Realtime WebSocket Server (optional) ---
NEXT_PUBLIC_VOICE_REALTIME_URL=ws://localhost:3001
REALTIME_PORT=3001
