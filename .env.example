# ============================================================
# VoiceAI — Environment Variables
# Copy this file to .env.local and fill in your API keys
# ============================================================

# Groq API — LLM (Chat Completions)
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=
VOICE_LLM_MODEL=llama-3.3-70b-versatile

# Sarvam AI — Speech-to-Text & Text-to-Speech
# Get your key at: https://dashboard.sarvam.ai
SARVAM_API_KEY=
VOICE_STT_PROVIDER=sarvam
VOICE_TTS_PROVIDER=sarvam

# Supabase — Database
# Get these from your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Voice Pipeline Optimization Settings
VOICE_VAD_HANGOVER_MS=200
VOICE_VAD_MIN_SPEECH_MS=80
VOICE_ECHO_GUARD_MS=60
VOICE_DEBUG_LATENCY=false

# Realtime Persistent Server (optional standalone service)
NEXT_PUBLIC_VOICE_REALTIME_URL=ws://localhost:3001
REALTIME_PORT=3001
